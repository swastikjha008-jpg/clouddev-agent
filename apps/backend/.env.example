NODE_ENV=development
PORT=8080

# Frontend origin(s) allowed to call this API — comma-separated for more than one
CORS_ORIGIN=http://localhost:3000

# Phase 1 — required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clouddev
GEMINI_API_KEY=

# Phase 1 — local sandbox
SANDBOX_IMAGE=clouddev/sandbox-agent:local
SANDBOX_MAX_RUNTIME_MS=2700000
SANDBOX_IDLE_TIMEOUT_MS=600000

# Phase 2 — GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Phase 3 — AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
REDIS_URL=
S3_BUCKET=
